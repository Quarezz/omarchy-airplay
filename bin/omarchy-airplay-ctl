#!/usr/bin/env python3
import ipaddress,json,os,re,selectors,signal,stat,subprocess,sys,time
MAX=65536; NAMES=96; IDS=re.compile(r"^[0-9A-Fa-f:]{2,64}$")
def die(s,c=2): print(s,file=sys.stderr); raise SystemExit(c)
def dfd(name,create=False):
 base=os.environ.get("XDG_CONFIG_HOME",os.path.expanduser("~/.config"))
 b=os.open(base,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
 try:
  if create:
   try: os.mkdir(name,0o700,dir_fd=b)
   except FileExistsError: pass
  d=os.open(name,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=b); x=os.fstat(d)
  if x.st_uid!=os.getuid() or not stat.S_ISDIR(x.st_mode) or x.st_mode&0o022: os.close(d); die("Unsafe state directory")
  return d
 finally: os.close(b)
def read(d,n,limit=MAX):
 try: f=os.open(n,os.O_RDONLY|os.O_NOFOLLOW,dir_fd=d)
 except FileNotFoundError:return None
 try:
  x=os.fstat(f)
  if not stat.S_ISREG(x.st_mode) or x.st_uid!=os.getuid() or x.st_mode&0o022 or x.st_size>limit:die("Unsafe or oversized state file")
  z=os.read(f,limit+1)
  if len(z)>limit:die("Oversized state file")
  return z
 finally:os.close(f)
def write(d,n,z):
 t="."+n+"."+str(os.getpid()); f=os.open(t,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=d)
 try:os.write(f,z);os.fsync(f)
 finally:os.close(f)
 os.replace(t,n,src_dir_fd=d,dst_dir_fd=d);os.fsync(d)
def clean(s,n):return "".join(c if c>=" " and c not in "\t\n\r" else " " for c in s)[:n].strip()
def creds():
 try:d=dfd("doubletake")
 except FileNotFoundError:return {}
 try:
  z=read(d,"credentials.json",1048576)
  if z is None:return {}
  v=json.loads(z.decode())
  if not isinstance(v,dict):die("Invalid DoubleTake credentials")
  return v
 except (UnicodeDecodeError,json.JSONDecodeError):die("Invalid DoubleTake credentials")
 finally:os.close(d)
def load_paired(d):
 rows=[]
 for line in (read(d,"paired.tsv",8192) or b"").decode("utf-8","strict").splitlines():
  f=line.split("\t")
  if len(f)<3 or not IDS.fullmatch(f[2]):continue
  try:rows.append((clean(f[0],NAMES) or f[1],str(ipaddress.IPv4Address(f[1])),f[2]))
  except ValueError:continue
 return rows
def save_paired(d,rows):
 out=[];seen=set()
 for name,addr,i in rows:
  if i in seen:continue
  seen.add(i);out.append(f"{name}\t{addr}\t{i}")
  if len(out)==32:break
 write(d,"paired.tsv",("\n".join(out)+("\n" if out else "")).encode())
def remember(name,addr,device_id):
 if not device_id or not IDS.fullmatch(device_id):return
 try:a=str(ipaddress.IPv4Address(addr))
 except ValueError:return
 d=dfd("omarchy-airplay",True)
 try:
  rows=[(n,ad,i) for n,ad,i in load_paired(d) if i!=device_id]
  rows.insert(0,(clean(name,NAMES) or a,a,device_id));save_paired(d,rows)
 finally:os.close(d)
def unremember(device_id):
 try:d=dfd("omarchy-airplay")
 except FileNotFoundError:return
 try:save_paired(d,[(n,a,i) for n,a,i in load_paired(d) if i!=device_id])
 finally:os.close(d)
def paired_list():
 try:d=dfd("omarchy-airplay",True)
 except FileNotFoundError:return
 try:
  rows=load_paired(d); z=read(d,"target.tsv",4096)
  if z:
   f=z.decode("utf-8","replace").strip().split("\t")
   if len(f)>=3 and IDS.fullmatch(f[2]):
    try:
     addr=str(ipaddress.IPv4Address(f[1])); name=clean(f[0],NAMES) or addr
     if f[2] not in [i for _,_,i in rows]:
      rows.insert(0,(name,addr,f[2])); save_paired(d,rows)
    except ValueError:pass
  c=creds(); n=0
  for name,addr,i in rows:
   if i not in c:continue
   print(f"{name}\t{addr}\t{i}\t1"); n+=1
   if n==32:return
 finally:os.close(d)
def discovery_flag(q,a):
 try:d=dfd("omarchy-airplay",q=="discovery-set")
 except FileNotFoundError:
  if q=="discovery-get":print("0");return
  die("Unsafe state directory")
 try:
  if q=="discovery-get":
   z=read(d,"discovery.enabled",8); print("1" if z and z.strip()==b"1" else "0"); return
  if len(a)!=1 or a[0] not in ("0","1"):die("Invalid discovery flag")
  write(d,"discovery.enabled",(a[0]+"\n").encode())
 finally:os.close(d)
def discovery():
 try:p=subprocess.Popen(["avahi-browse","--resolve","--terminate","--parsable","_airplay._tcp"],stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,start_new_session=True)
 except FileNotFoundError:die("avahi-browse is required",127)
 out=bytearray();s=selectors.DefaultSelector();s.register(p.stdout,selectors.EVENT_READ);deadline=time.monotonic()+8
 while p.poll() is None:
  if time.monotonic()>deadline:os.killpg(p.pid,9);die("AirPlay discovery timed out",124)
  for k,_ in s.select(.2):
   z=os.read(k.fileobj.fileno(),4096);out.extend(z)
   if len(out)>MAX:os.killpg(p.pid,9);die("AirPlay discovery output exceeded limit",125)
 while True:
  z=os.read(p.stdout.fileno(),4096)
  if not z:break
  out.extend(z)
  if len(out)>MAX:die("AirPlay discovery output exceeded limit",125)
 if p.returncode:die("AirPlay discovery failed",p.returncode)
 seen=set(); c=creds()
 for line in out.decode("utf-8","replace").splitlines():
  f=line.split(";")
  if len(f)<10 or f[0]!="=" or f[2]!="IPv4":continue
  try:a=str(ipaddress.IPv4Address(f[7]))
  except ValueError:continue
  if a in seen:continue
  name=clean(re.sub(r"\\(\d{3})",lambda m:chr(int(m.group(1))),f[3]),NAMES) or a
  m=re.search(r"deviceid=([0-9A-Fa-f:]+)",f[9]); i=m.group(1) if m and IDS.fullmatch(m.group(1)) else ""
  print(f"{name}\t{a}\t{i}\t{int(i in c)}");seen.add(a)
  if i:remember(name,a,i)
  if len(seen)==32:return
def firewall(q,a):
 if not a or not IDS.fullmatch(a[0]):die("Invalid device ID")
 d=dfd("omarchy-airplay",q=="firewall-save")
 try:
  old=(read(d,"firewall.tsv",4096) or b"").decode("utf-8","strict").splitlines()
  if q=="firewall-load":
   for line in old:
    if line.split("\t",1)[0]==a[0]:print(line);return
   raise SystemExit(1)
  rows=[x for x in old if x.split("\t",1)[0]!=a[0]]
  if q=="firewall-save":
   if len(a)!=3:die("Invalid firewall rule")
   addr=str(ipaddress.IPv4Address(a[1])); m=re.fullmatch(r"(\d{1,5})-(\d{1,5})",a[2])
   if not m or not (0<int(m.group(1))<=int(m.group(2))<=65535):die("Invalid UDP port range")
   rows.append("\t".join((a[0],addr,a[2])))
  write(d,"firewall.tsv",("\n".join(rows)+("\n" if rows else "")).encode())
 finally:os.close(d)
def network():
 try:r=subprocess.run(["ip","-4","route","show","default"],capture_output=True,text=True,timeout=3).stdout.split()
 except (subprocess.TimeoutExpired,FileNotFoundError):raise SystemExit(1)
 if "dev" not in r:raise SystemExit(1)
 dev=r[r.index("dev")+1]; ip=subprocess.run(["ip","-o","-4","addr","show","dev",dev,"scope","global"],capture_output=True,text=True,timeout=3).stdout.split()
 print("\t".join((clean(dev,32),"","",next((x for x in ip if "/" in x),""),"")))
def reap(addr):
 try:target=str(ipaddress.ip_address(addr))
 except ValueError:die("Invalid target")
 n=0
 for name in os.listdir("/proc"):
  if not name.isdigit():continue
  try:z=open("/proc/%s/cmdline"%name,"rb").read()
  except OSError:continue
  parts=[x.decode("utf-8","replace") for x in z.split(b"\0") if x]
  if not parts or os.path.basename(parts[0])!="doubletake":continue
  try:i=parts.index("-target")
  except ValueError:continue
  if i+1<len(parts) and parts[i+1]==target:
   try:os.kill(int(name),signal.SIGTERM);n+=1
   except OSError:pass
 print(n)
def main():
 if len(sys.argv)<2:die("Missing command")
 q,a=sys.argv[1],sys.argv[2:]
 if q=="discover":return discovery()
 if q=="paired-list":return paired_list()
 if q in ("discovery-get","discovery-set"):return discovery_flag(q,a)
 if q=="remember":
  if len(a)!=3:die("Invalid receiver")
  remember(a[0],a[1],a[2]);return
 if q=="network":return network()
 if q=="reap":
  if len(a)!=1:die("Invalid target")
  return reap(a[0])
 if q=="set-restore":
  if len(a)!=2 or not IDS.fullmatch(a[0]) or not re.fullmatch(r"[A-Za-z0-9._:-]{8,256}",a[1]):die("Invalid restore token")
  d=dfd("doubletake",True)
  try:
   v=creds(); cur=v.get(a[0])
   if not isinstance(cur,dict):cur={}
   cur["restore_token"]=a[1]; v[a[0]]=cur
   write(d,"credentials.json",json.dumps(v,separators=(",",":")).encode())
  finally:os.close(d)
  return
 if q in ("firewall-load","firewall-save","firewall-clear"):return firewall(q,a)
 if q in ("load","save","clear"):
  d=dfd("omarchy-airplay",q=="save")
  try:
   if q=="load":
    z=read(d,"target.tsv",4096)
    if z:sys.stdout.buffer.write(z)
   elif q=="clear":
    try:os.unlink("target.tsv",dir_fd=d)
    except FileNotFoundError:pass
   else:
    if len(a)not in(2,3):die("Invalid target")
    name=clean(a[0],NAMES);addr=str(ipaddress.ip_address(a[1]));i=a[2] if len(a)==3 and IDS.fullmatch(a[2]) else ""
    write(d,"target.tsv",f"{name}\t{addr}\t{i}\n".encode())
    if i:remember(name,addr,i)
  finally:os.close(d)
 elif q in ("paired","forget","clear-restore"):
  if len(a)!=1 or not IDS.fullmatch(a[0]):die("Invalid device ID")
  if q=="paired":raise SystemExit(0 if a[0] in creds() else 1)
  d=dfd("doubletake",True)
  try:
   v=creds();v.pop(a[0],None) if q=="forget" else (v.get(a[0],{}).pop("restore_token",None) if isinstance(v.get(a[0]),dict) else None)
   write(d,"credentials.json",json.dumps(v,separators=(",",":")).encode())
  finally:os.close(d)
  if q=="forget":unremember(a[0])
 else:die("Unknown command")
if __name__=="__main__":main()
