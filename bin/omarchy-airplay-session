#!/usr/bin/env python3
"""Start an AirPlay mirror. DoubleTake shows the share picker on connect."""
import argparse, os, re, signal, subprocess, sys, time

CTL = os.path.join(os.path.dirname(os.path.realpath(__file__)), "omarchy-airplay-ctl")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "omarchy-airplay")
LOG = os.path.join(STATE, "session.log")


def die(msg, code=2):
    print(msg, file=sys.stderr)
    raise SystemExit(code)


def run(cmd, timeout=30):
    p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    if p.returncode:
        detail = (p.stderr or p.stdout or "").strip() or ("exit %s" % p.returncode)
        die(detail, p.returncode)
    return p


def start(args):
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    if args.device_id:
        try:
            n = int(run([CTL, "reap", args.target], timeout=5).stdout.strip() or "0")
        except (subprocess.CalledProcessError, ValueError, SystemExit):
            n = 0
        if n:
            time.sleep(4)
        # Forget the last capture so DoubleTake always opens the Hyprland picker.
        if args.prompt_capture:
            try:
                run([CTL, "clear-restore", args.device_id], timeout=5)
            except SystemExit:
                pass
    cmd = [args.doubletake, "-target", args.target, "-port-range", args.port_range,
           "-video-codec", args.video_codec, "-hwaccel", args.hwaccel,
           "-fps", str(args.fps), "-target-latency-ms", str(args.latency)]
    if not args.audio:
        cmd.append("-no-audio")
    if args.code:
        cmd.extend(["-pair", "-code", args.code])
    print("Connecting to the TV…", file=sys.stderr)
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    def stop(signum, _frame):
        if proc.poll() is None:
            proc.send_signal(signal.SIGTERM)
        raise SystemExit(143)
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    with open(LOG, "w", encoding="utf-8") as logf:
        for line in proc.stdout:
            logf.write(line)
            logf.flush()
            sys.stderr.write(line)
            sys.stderr.flush()
    raise SystemExit(proc.wait() or 0)


def main():
    p = argparse.ArgumentParser()
    p.add_argument("command", choices=["start"])
    p.add_argument("--target", required=True)
    p.add_argument("--device-id", default="")
    p.add_argument("--doubletake", default="doubletake")
    p.add_argument("--port-range", default="60000-60010")
    p.add_argument("--video-codec", default="h264")
    p.add_argument("--hwaccel", default="nvenc")
    p.add_argument("--fps", type=int, default=30)
    p.add_argument("--latency", type=int, default=180)
    p.add_argument("--audio", action="store_true")
    p.add_argument("--prompt-capture", action="store_true")
    p.add_argument("--code", default="")
    args = p.parse_args()
    if not re.fullmatch(r"\d{1,3}(?:\.\d{1,3}){3}", args.target):
        die("invalid target")
    if args.device_id and not re.fullmatch(r"[0-9A-Fa-f:]{2,64}", args.device_id):
        die("invalid device id")
    if args.doubletake != "doubletake" and not re.fullmatch(r"/[A-Za-z0-9._/-]*/doubletake", args.doubletake):
        die("invalid doubletake path")
    if args.command == "start":
        start(args)


if __name__ == "__main__":
    main()
